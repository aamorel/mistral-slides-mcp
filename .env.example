GOOGLE_CLIENT_ID=your-existing-web-client-id
GOOGLE_CLIENT_SECRET=your-existing-web-client-secret
PUBLIC_BASE_URL=https://mistral-slides-mcp-production.up.railway.app
TOKEN_DB_PATH=/data/tokens.sqlite3
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-medium-latest

# Optional image-generation orchestrator (uses MISTRAL_API_KEY)
MISTRAL_IMAGE_MODEL=mistral-medium-latest

# Client-only pilot. Empty/missing allowlists deny everyone.
GOOGLE_ALLOWED_DOMAIN=mistral.ai
# Remove vmaxmc2@gmail.com before submission, then redeploy/restart.
GOOGLE_ALLOWED_EMAILS=aurelien.morel.arthur@gmail.com,vmaxmc2@gmail.com
# Lifetime allowance in this token DB; failures count. Not a currency cap.
PILOT_MAX_PAID_CALLS=100
PILOT_MAX_CONCURRENT_CALLS=2
PILOT_PAID_CALLS_ENABLED=true
